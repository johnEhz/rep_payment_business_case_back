# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=store_db
DB_SYNCHRONIZE=true

# Credenciales Sandbox Pasarela de Pagos
GATEWAY_PUBLIC_KEY=your_public_key_here
GATEWAY_PRIVATE_KEY=your_private_key_here
GATEWAY_INTEGRITY_SECRET=your_integrity_secret_here
GATEWAY_API_URL=https://api.payment-gateway.example/v1

# Tarifas de negocio (en centavos de COP)
# 1000 COP = 100000 centavos
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=1000000
