{
  "Template": {
    "TemplateName": "PaymentApprovedTemplate",
    "SubjectPart": "Comprobante de Pago y Entrega - {{orderNumber}}",
    "HtmlPart": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>Comprobante de Pago y Entrega</title></head><body style=\"margin:0;padding:0;background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#2d3748;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f4f6f8;padding:30px 15px;\"><tr><td align=\"center\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;\"><tr><td style=\"background-color:#1a365d;padding:28px 32px;text-align:left;\"><span style=\"font-size:20px;font-weight:700;color:#ffffff;text-transform:uppercase;\">Tienda Online</span><p style=\"margin:6px 0 0 0;font-size:13px;color:#cbd5e0;\">Confirmacion de pago y comprobante de entrega</p></td></tr><tr><td style=\"padding:32px;\"><h1 style=\"margin:0 0 12px 0;font-size:20px;color:#1a202c;\">Hola {{customerName}},</h1><p style=\"margin:0 0 20px 0;font-size:14px;line-height:1.6;color:#4a5568;\">Tu transaccion ha sido aprobada correctamente y el proceso de compra ha finalizado satisfactoriamente.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f0fff4;border:1px solid #9ae6b4;border-radius:6px;margin-bottom:24px;\"><tr><td style=\"padding:16px 20px;text-align:center;\"><span style=\"font-size:12px;font-weight:700;text-transform:uppercase;color:#22543d;letter-spacing:1px;\">Estado del Pedido</span><div style=\"font-size:18px;font-weight:800;color:#276749;margin-top:4px;\">ENTREGADO</div><div style=\"font-size:13px;color:#4a5568;margin-top:4px;\">El envio ha sido despachado y entregado en la direccion indicada.</div></td></tr></table><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f7fafc;border:1px solid #edf2f7;border-radius:6px;margin-bottom:24px;\"><tr><td style=\"padding:14px 20px;border-bottom:1px solid #edf2f7;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Numero de Pedido</span><div style=\"font-size:15px;font-weight:700;color:#1a365d;margin-top:2px;\">{{orderNumber}}</div></td><td style=\"padding:14px 20px;border-bottom:1px solid #edf2f7;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Referencia de Pago</span><div style=\"font-size:14px;font-weight:600;color:#2d3748;margin-top:2px;\">{{transactionReference}}</div></td></tr><tr><td style=\"padding:14px 20px;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Metodo de Pago</span><div style=\"font-size:14px;color:#2d3748;margin-top:2px;\">Tarjeta de Credito / Debito</div></td><td style=\"padding:14px 20px;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Total Pagado</span><div style=\"font-size:16px;font-weight:700;color:#276749;margin-top:2px;\">{{totalFormatted}}</div></td></tr><tr><td colspan=\"2\" style=\"padding:14px 20px;border-top:1px solid #edf2f7;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Direccion de Entrega</span><div style=\"font-size:14px;color:#2d3748;margin-top:2px;\">{{deliveryAddress}}, {{deliveryCity}}</div></td></tr></table><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 16px 0;\"><tr><td align=\"center\"><a href=\"{{trackingUrl}}\" target=\"_blank\" style=\"background-color:#276749;color:#ffffff;text-decoration:none;padding:13px 28px;border-radius:6px;font-size:14px;font-weight:600;display:inline-block;\">Ver Detalle del Pedido</a></td></tr></table><p style=\"margin:24px 0 0 0;font-size:12px;color:#a0aec0;text-align:center;\">Enlace directo: {{trackingUrl}}</p></td></tr><tr><td style=\"background-color:#edf2f7;padding:20px 32px;text-align:center;border-top:1px solid #e2e8f0;\"><p style=\"margin:0;font-size:12px;color:#718096;\">Mensaje automatico generado por el sistema. No responder a este correo.</p></td></tr></table></td></tr></table></body></html>",
    "TextPart": "Hola {{customerName}},\n\nTu pago para el pedido #{{orderNumber}} ha sido aprobado exitosamente.\n\nReferencia: {{transactionReference}}\nTotal Pagado: {{totalFormatted}}\nDireccion de Entrega: {{deliveryAddress}}, {{deliveryCity}}\nEstado del Pedido: ENTREGADO\n\nPuedes consultar el detalle en: {{trackingUrl}}\n\nGracias por comprar con nosotros."
  }
