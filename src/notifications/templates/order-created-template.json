{
  "Template": {
    "TemplateName": "OrderCreatedTemplate",
    "SubjectPart": "Confirmacion de Pedido - {{orderNumber}}",
    "HtmlPart": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>Confirmacion de Pedido</title></head><body style=\"margin:0;padding:0;background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#2d3748;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f4f6f8;padding:30px 15px;\"><tr><td align=\"center\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;\"><tr><td style=\"background-color:#1a365d;padding:28px 32px;text-align:left;\"><span style=\"font-size:20px;font-weight:700;color:#ffffff;text-transform:uppercase;\">Tienda Online</span><p style=\"margin:6px 0 0 0;font-size:13px;color:#cbd5e0;\">Confirmacion de creacion de pedido</p></td></tr><tr><td style=\"padding:32px;\"><h1 style=\"margin:0 0 12px 0;font-size:20px;color:#1a202c;\">Estimado(a) {{customerName}},</h1><p style=\"margin:0 0 20px 0;font-size:14px;line-height:1.6;color:#4a5568;\">Hemos registrado tu pedido con exito. El inventario de tus productos ha sido reservado de forma temporal mientras completas el proceso de pago.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f7fafc;border:1px solid #edf2f7;border-radius:6px;margin-bottom:24px;\"><tr><td style=\"padding:16px 20px;border-bottom:1px solid #edf2f7;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Numero de Pedido</span><div style=\"font-size:16px;font-weight:700;color:#1a365d;margin-top:4px;\">{{orderNumber}}</div></td><td style=\"padding:16px 20px;border-bottom:1px solid #edf2f7;text-align:right;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Estado</span><div style=\"font-size:13px;font-weight:700;color:#c05621;margin-top:4px;\">Pendiente de Pago</div></td></tr><tr><td colspan=\"2\" style=\"padding:16px 20px;\"><span style=\"font-size:12px;font-weight:600;text-transform:uppercase;color:#718096;\">Direccion de Entrega</span><div style=\"font-size:14px;color:#2d3748;margin-top:4px;\">{{deliveryAddress}}, {{deliveryCity}}</div></td></tr></table><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-bottom:24px;font-size:14px;\"><tr><td style=\"padding:8px 0;color:#718096;\">Subtotal productos:</td><td style=\"padding:8px 0;text-align:right;font-weight:600;color:#2d3748;\">{{subtotalFormatted}}</td></tr><tr><td style=\"padding:8px 0;color:#718096;\">Costo de envio (Delivery):</td><td style=\"padding:8px 0;text-align:right;font-weight:600;color:#2d3748;\">{{deliveryFeeFormatted}}</td></tr><tr style=\"border-top:1px solid #e2e8f0;\"><td style=\"padding:12px 0;font-size:15px;font-weight:700;color:#1a202c;\">Total a Pagar:</td><td style=\"padding:12px 0;text-align:right;font-size:16px;font-weight:700;color:#1a365d;\">{{totalFormatted}}</td></tr></table><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#fffaf0;border-left:4px solid #dd6b20;border-radius:4px;margin-bottom:24px;\"><tr><td style=\"padding:14px 16px;font-size:13px;line-height:1.5;color:#9c4221;\"><strong>Importante:</strong> Dispones de 15 minutos para efectuar tu pago antes de que expire la reserva de inventario.</td></tr></table><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 16px 0;\"><tr><td align=\"center\"><a href=\"{{trackingUrl}}\" target=\"_blank\" style=\"background-color:#2b6cb0;color:#ffffff;text-decoration:none;padding:13px 28px;border-radius:6px;font-size:14px;font-weight:600;display:inline-block;\">Consultar Estado del Pedido</a></td></tr></table><p style=\"margin:24px 0 0 0;font-size:12px;color:#a0aec0;text-align:center;\">Enlace directo: {{trackingUrl}}</p></td></tr><tr><td style=\"background-color:#edf2f7;padding:20px 32px;text-align:center;border-top:1px solid #e2e8f0;\"><p style=\"margin:0;font-size:12px;color:#718096;\">Mensaje automatico generado por el sistema. No responder a este correo.</p></td></tr></table></td></tr></table></body></html>",
    "TextPart": "Estimado(a) {{customerName}},\n\nHemos registrado tu pedido #{{orderNumber}} con exito.\n\nDireccion de Entrega: {{deliveryAddress}}, {{deliveryCity}}\nSubtotal: {{subtotalFormatted}}\nCosto de envio: {{deliveryFeeFormatted}}\nTotal a Pagar: {{totalFormatted}}\n\nDispones de 15 minutos para completar el pago antes de que expire la reserva de stock.\nPuedes seguir tu pedido en: {{trackingUrl}}\n\nGracias por tu compra."
  }
}
