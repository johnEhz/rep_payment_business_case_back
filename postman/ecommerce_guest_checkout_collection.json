        {
          "name": "4.3 Webhook de Notificacion Asincrona (Idempotente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transaction.updated\",\n  \"data\": {\n    \"transaction\": {\n      \"id\": \"gw-tx-webhook-sim-01\",\n      \"status\": \"APPROVED\",\n      \"amount_in_cents\": 15400000,\n      \"reference\": \"{{orderNumber}}-sim\",\n      \"customer_email\": \"juan.perez@example.com\"\n    }\n  },\n  \"sent_at\": \"2026-09-24T22:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{webhookUrl}}",
              "host": [
                "{{webhookUrl}}"
              ]
            },
            "description": "Endpoint para recibir webhooks de la pasarela de pagos. Implementa verificacion de idempotencia."
          }
        }
      ]
    },
    {
      "name": "5. Transacciones Directas (Flujo Alternativo)",
      "description": "Endpoints para compra directa de un solo producto y cotizacion rapida.",
      "item": [
        {
          "name": "5.1 Calcular Tarifas Dinamicas de Transaccion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/fees?productId={{productId}}&quantity=1&deliveryAddress=Cra%2073B%20%2375-171&deliveryCity=Medellin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "fees"
              ],
              "query": [
                {
                  "key": "productId",
                  "value": "{{productId}}"
                },
                {
                  "key": "quantity",
                  "value": "1"
                },
                {
                  "key": "deliveryAddress",
                  "value": "Cra 73B #75-171"
                },
                {
                  "key": "deliveryCity",
                  "value": "Medellin"
                }
              ]
            },
            "description": "Calcula el desglose de tarifa base, producto y delivery dinamico."
          }
        },
        {
          "name": "5.2 Checkout Directo de Transaccion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set(\"transactionId\", data.id);",
                  "if (data.reference) pm.collectionVariables.set(\"transactionReference\", data.reference);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
