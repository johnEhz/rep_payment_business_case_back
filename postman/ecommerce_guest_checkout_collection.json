    {
      "name": "2. Delivery & Mapbox API",
      "description": "Motor de calculo dinamico de tarifas de entrega con Mapbox y georreferenciacion local desde la tienda en Robledo, Medellin.",
      "item": [
        {
          "name": "2.1 Calcular Tarifa Completa de Delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalPurchaseAmountInCents\": 15000000,\n  \"deliveryAddress\": \"Cra 73B #75-171, Robledo\",\n  \"deliveryCity\": \"Medellin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/calculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery",
                "calculate"
              ]
            },
            "description": "Calcula la tarifa considerando:\n1. Distancia en km desde la tienda base (`Cra 73B #75-171, Robledo, Medellin`)\n2. Rango por valor de compra\n3. Regla de descuentos: $80.000+ envio gratis, $50.000+ 50% de descuento."
          }
        },
        {
          "name": "2.2 Estimacion Rapida de Delivery (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/delivery/estimate?amountInCents=15000000&address=Cra%2073B%20%2375-171&city=Medellin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery",
                "estimate"
              ],
              "query": [
                {
                  "key": "amountInCents",
                  "value": "15000000"
                },
                {
                  "key": "address",
                  "value": "Cra 73B #75-171"
                },
                {
                  "key": "city",
                  "value": "Medellin"
                }
              ]
            },
            "description": "Endpoint ligero para precargar el costo de envio en el carrito de compras."
          }
        },
        {
          "name": "2.3 Consultar Delivery por Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/delivery/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery",
                "order",
                "{{orderId}}"
              ]
            },
            "description": "Consulta los datos del envio, estado y repartidor asignado a una orden."
          }
        },
        {
          "name": "2.4 Actualizar Estado de Despacho (Driver/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\",\n  \"driverId\": \"driver-med-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/{{deliveryId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery",
                "{{deliveryId}}",
                "status"
              ]
            },
            "description": "Actualiza manualmente el estado de entrega (`PENDING`, `DISPATCHED`, `DELIVERED`)."
          }
        }
      ]
    },
    {
      "name": "3. Flujo Guest Checkout (Sin Registro)",
      "description": "El flujo principal de compra para invitados: cotizacion, creacion de orden, reserva de stock atomica por 15 minutos, pagos y seguimiento seguro.",
      "item": [
        {
          "name": "3.1 Preview del Checkout (Cotizacion Previa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"deliveryAddress\": \"Cra 73B #75-171\",\n  \"deliveryCity\": \"Medellin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "preview"
              ]
            },
            "description": "Valida stock disponible y calcula el subtotal y costo exacto de delivery antes de confirmar la compra."
          }
        },
        {
          "name": "3.2 Crear Orden de Invitado (Reserva 15 Min)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set(\"orderNumber\", data.orderNumber);",
                  "pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "pm.collectionVariables.set(\"orderId\", data.id);",
                  "if (data.delivery) pm.collectionVariables.set(\"deliveryId\", data.delivery.id);",
                  "console.log(\"Guardado orderNumber:\", data.orderNumber, \"accessToken:\", data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Juan Perez Evaluador\",\n  \"customerEmail\": \"juan.perez@example.com\",\n  \"customerPhone\": \"3001234567\",\n  \"deliveryAddress\": \"Cra 73B #75-171\",\n  \"deliveryCity\": \"Medellin\",\n  \"deliveryNotes\": \"Dejar en porteria de la unidad residencial\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "order"
              ]
            },
            "description": "Crea la orden en estado `PENDING_PAYMENT`, reserva el inventario por 15 minutos de forma atomica y emite un `accessToken` criptografico de invitado."
          }
        },
        {
          "name": "3.3 Pagar Orden (Simular Aprobado -> Estado DELIVERED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"{{orderNumber}}\",\n  \"accessToken\": \"{{accessToken}}\",\n  \"acceptanceToken\": \"acceptance_token_placeholder\",\n  \"cardToken\": \"tok_test_card_approved\",\n  \"installments\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "pay"
              ]
            },
            "description": "Procesa el pago con la pasarela. Al ser aprobado:\n- La orden pasa automaticamente a `DELIVERED`.\n- El Delivery pasa a `DELIVERED`.\n- La reserva de inventario pasa a `CONFIRMED`.\n- Se emite la notificacion por correo con plantilla nativa de SES."
          }
        },
        {
          "name": "3.4 Pagar Orden (Simular Rechazado -> Liberacion Inmediata Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"{{orderNumber}}\",\n  \"accessToken\": \"{{accessToken}}\",\n  \"acceptanceToken\": \"acceptance_token_placeholder\",\n  \"cardToken\": \"tok_test_card_declined\",\n  \"installments\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "pay"
              ]
            },
            "description": "Demuestra la regla critica de negocio: si la pasarela declina el pago, las reservas de stock pasan inmediatamente a `RELEASED`, quedando disponibles al instante en el catalogo."
          }
        },
        {
          "name": "3.5 Seguimiento Seguro de Orden (Tracking Invitado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/track/{{orderNumber}}?token={{accessToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "track",
                "{{orderNumber}}"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            },
            "description": "Permite al cliente invitado consultar el estado de su orden, transacciones y delivery en tiempo real utilizando su token de seguridad."
          }
        },
        {
          "name": "3.6 Tracking con Token Invalido (Seguridad - Error 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/track/{{orderNumber}}?token=token_invalido_de_prueba",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "track",
                "{{orderNumber}}"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "token_invalido_de_prueba"
                }
              ]
            },
            "description": "Demuestra el control de acceso: si un tercero intenta consultar una orden sin el token correcto, el sistema responde con 401 Unauthorized."
          }
        },
        {
          "name": "3.7 Consultar Estado de Pago (Payment Status Reactivo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/payment-status/{{orderNumber}}?token={{accessToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "payment-status",
                "{{orderNumber}}"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            },
            "description": "Consulta el estado de la orden y transaccion con validacion reactiva Just-In-Time contra la pasarela de pagos."
          }
        },
        {
          "name": "3.8 Consultar Orden Activa de Sesion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkout/active-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "active-order"
              ]
            },
            "description": "Consulta si existe una orden en curso con transacciones pendientes en la sesion."
          }
        },
        {
          "name": "3.9 Cancelar Orden Activa de Sesion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkout/cancel-active-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "cancel-active-order"
              ]
            },
            "description": "Cancela la orden activa de la sesion y libera el inventario reservado."
          }
        }
      ]
    },
    {
      "name": "4. Pasarela de Pagos & Webhooks",
      "description": "Endpoints de interaccion con la pasarela de pagos y recepcion asincrona de webhooks.",
      "item": [
        {
          "name": "4.1 Obtener Datos de Comercio de la Pasarela",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/merchant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "merchant"
              ]
            },
            "description": "Consulta los tokens de aceptacion de terminos y politicas de la pasarela."
          }
        },
        {
          "name": "4.2 Historial de Intentos de Pago de la Orden",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/order/{{orderId}}",
              "host": [
